// Alientek DM40 (GD32F427VGT6 ~ STM32F427, Cortex-M4F @ 200 MHz) for Renode.
// Written from scratch (not `using stm32f4.repl`): the DM40 needs the FSMC bank
// mapped to the LCD model, 200 MHz timers, the GD32 memory map and only PE5
// on EXTI line 5. Peripheral models: Renode built-ins where they fit, DM40
// specific ones from peripherals/*.cs (included by the .resc).
//
// Memory (ANALYSIS.md section 1/4, native-boot.md):
//   0x08000000  1 MiB flash (ROM boot 16K, app, FS-loader @0xA0000, UID data
//               @0xA4000, calibration @0xC0000, flag @0xFF000)
//   0x10000000  TCM SRAM 64K       0x20000000 SRAM 192K (SRAM0/1 + ADDSRAM)
//   0x40024000  backup SRAM 4K     0x1FFF7800 OTP, UID @0x1FFF7A10
//   0x40060000  USBHS FIFO RAM 4K
//   0x60000000  FSMC bank 1 -> ILI9488 (A16 = RS)   0xA0000000 FSMC registers

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic
    PerformanceInMips: 200

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 200000000
    IRQ -> cpu@0

dwt: Miscellaneous.DM40_DWT @ sysbus 0xE0001000
    frequency: 200000000

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

tcm: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x10000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x30000

bkpsram: Memory.MappedMemory @ sysbus 0x40024000
    size: 0x1000

// USBHS FIFO RAM (the DWC2 core's direct FIFO window, base + 0x20000): the
// DM40 has no USBHS port; opendm40 keeps CPU-only buffers there
// (link-native.x .usbhs_bss; the device probe of PR #183). As on the device,
// a byte / halfword store writes the whole word with the value replicated
// (peripherals/WordOnlyRam.cs; firmware/src/wordram.rs). The USBHSEN clock
// gate is not modelled.
usbhs_fifo: Miscellaneous.WordOnlyRam @ sysbus 0x40060000
    size: 0x1000

// System memory: OTP 0x1FFF7800 (512 B + 16 lock), UID 0x1FFF7A10, flash size 0x1FFF7A22
sysmem: Memory.MappedMemory @ sysbus 0x1FFF0000
    size: 0xC000

flash_controller: MTD.STM32F4_FlashController @ {
        sysbus 0x40023C00;
        sysbus new Bus.BusMultiRegistration { address: 0x1FFFC000; size: 0x100; region: "optionBytes" }
    }
    flash: flash

// FSMC register block (BCR/BTR/BWTR): plain storage is enough, the LCD model
// does not depend on the timing fields.
fsmc_regs: Memory.MappedMemory @ sysbus 0xA0000000
    size: 0x1000

// FSMC bank 1 (NE1..NE4, 4 x 64 MiB): the ILI9488 on NE1, RS = A16.
lcd: Video.ILI9488 @ sysbus 0x60000000

syscfg: Memory.MappedMemory @ sysbus 0x40013800
    size: 0x400

rcc: Miscellaneous.STM32F4_RCC @ sysbus 0x40023800
    rtcPeripheral: rtc

pwr: Miscellaneous.STM32_PWR @ sysbus 0x40007000

crc: CRC.STM32_CRC @ sysbus 0x40023000
    series: STM32Series.F4

rtc: Timers.STM32F4_RTC @ sysbus 0x40002800
    AlarmIRQ -> nvic@41

// Free watchdog + the sticky RCU_RSTSCK reset flags (peripherals/FWDGT.cs;
// run.py routes RSTSCK reads / RSTFC and SYSRESETREQ to it with bus hooks).
fwdgt: Timers.DM40_FWDGT @ sysbus 0x40003000
    frequency: 32000

exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40013C00
    numberOfOutputLines: 24
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]
    [16, 17, 18, 22] -> nvic@[1, 41, 42, 3]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

// GPIO. Only the lines the DM40 uses as EXTI sources are routed: PE5 (touch INT).
gpioPortA: GPIOPort.GD32_GPIO @ sysbus <0x40020000, +0x400>
    modeResetValue: 0xA8000000
    outputSpeedResetValue: 0x0C000000
    pullUpPullDownResetValue: 0x64000000
    numberOfAFs: 16
    15 -> timer2@0

gpioPortB: GPIOPort.GD32_GPIO @ sysbus <0x40020400, +0x400>
    modeResetValue: 0x00000280
    outputSpeedResetValue: 0x000000C0
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16

gpioPortC: GPIOPort.GD32_GPIO @ sysbus <0x40020800, +0x400>
    numberOfAFs: 16

gpioPortD: GPIOPort.GD32_GPIO @ sysbus <0x40020C00, +0x400>
    numberOfAFs: 16

gpioPortE: GPIOPort.GD32_GPIO @ sysbus <0x40021000, +0x400>
    numberOfAFs: 16
    5 -> exti@5

gpioPortF: GPIOPort.GD32_GPIO @ sysbus <0x40021400, +0x400>
    numberOfAFs: 16

gpioPortG: GPIOPort.GD32_GPIO @ sysbus <0x40021800, +0x400>
    numberOfAFs: 16

gpioPortH: GPIOPort.GD32_GPIO @ sysbus <0x40021C00, +0x400>
    numberOfAFs: 16

gpioPortI: GPIOPort.GD32_GPIO @ sysbus <0x40022000, +0x400>
    numberOfAFs: 16

bitbandPeripherals: Miscellaneous.BitBanding @ sysbus <0x42000000, +0x2000000>
    peripheralBase: 0x40000000

bitbandSram: Miscellaneous.BitBanding @ sysbus <0x22000000, +0x200000>
    peripheralBase: 0x20000000

// DMA0/DMA1 (GD32 names) = DMA1/DMA2 (STM32 names, used here).
dma1: DMA.GD32_DMA @ sysbus 0x40026000
    [0-7] -> nvic@[11-17,47]

dma2: DMA.GD32_DMA @ sysbus 0x40026400
    [0-7] -> nvic@[56-60,68-70]

// Timers: TIMPRE=1 -> every timer clock is 200 MHz on the DM40.
// TIM1/2/5/8 (the scope chains: TIM5 -> TIM1 -> TIM8 sample clocks, TIM2 trigger
// from PA15, opendm40 TIM2 OC2REF gating TIM1) are GD32_Timer with slave/trigger
// modes; ITRx inputs are GPIO 16..19 wired per the GD32F4 interconnect table
// (TIM1: ITR0=TIM5 ITR1=TIM2; TIM2: ITR0=TIM1 ITR1=TIM8; TIM8: ITR0=TIM1
// ITR3=TIM5). TIM7 is a GD32_Timer too (opendm40's AD2 stream ISR tick, below).
// TIM4/9..11 (interrupt tick timers) stay Renode's STM32_Timer,
// the PWM/trigger-only ones (TIM3/6/12/13/14) are the event-free PwmTimer.
timer1: Timers.GD32_Timer @ sysbus 0x40010000
    advanced: true
    BreakInterrupt -> nvic@24
    UpdateInterrupt -> nvic@25
    TriggerInterrupt -> nvic@26
    CaptureCompareInterrupt -> nvic@27
    TRGO -> timer8@16
    TRGO2 -> timer2@16

timer2: Timers.GD32_Timer @ sysbus 0x40000000
    IRQ -> nvic@28
    TRGO -> timer1@17

timer3: Timers.PwmTimer @ sysbus 0x40000400

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    -> nvic@30
    frequency: 200000000
    initialLimit: 0xFFFF

timer5: Timers.GD32_Timer @ sysbus 0x40000C00
    IRQ -> nvic@50
    TRGO -> timer1@16
    TRGO2 -> timer8@19

timer6: Timers.PwmTimer @ sysbus 0x40001000

// TIM7 (GD32 TIMER6): opendm40's AD2 stream tick (feature ad2-isr, the one
// interrupt opendm40 enables; UIE -> IRQ 55). GD32_Timer: URS / UG / rc_w0 SR /
// CNT as the firmware programs them (Renode's STM32_Timer differs).
timer7: Timers.GD32_Timer @ sysbus 0x40001400
    IRQ -> nvic@55

timer8: Timers.GD32_Timer @ sysbus 0x40010400
    advanced: true
    BreakInterrupt -> nvic@43
    UpdateInterrupt -> nvic@44
    TriggerInterrupt -> nvic@45
    CaptureCompareInterrupt -> nvic@46
    TRGO -> timer2@17

timer9: Timers.STM32_Timer @ sysbus 0x40014000
    -> nvic@24
    frequency: 200000000
    initialLimit: 0xFFFF

timer10: Timers.STM32_Timer @ sysbus 0x40014400
    -> nvic@25
    frequency: 200000000
    initialLimit: 0xFFFF

timer11: Timers.STM32_Timer @ sysbus 0x40014800
    -> nvic@26
    frequency: 200000000
    initialLimit: 0xFFFF

timer12: Timers.PwmTimer @ sysbus 0x40001800

timer13: Timers.PwmTimer @ sysbus 0x40001C00

timer14: Timers.PwmTimer @ sysbus 0x40002000

// UARTs. UART4 = Bluetooth module (PA0/PA1), DMA0 ch2 RX / ch4 TX.
usart1: UART.STM32_UART @ sysbus <0x40011000, +0x100>
    -> nvic@37

usart2: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    -> nvic@38

usart3: UART.STM32_UART @ sysbus <0x40004800, +0x100>
    -> nvic@39

uart4: UART.STM32_UART @ sysbus <0x40004C00, +0x100>
    -> nvic@52
    DMARequest -> dma1@2

// Bluetooth module behind UART4: AT responder + optional TCP passthrough; PC14 = connected.
btmodule: Miscellaneous.BtModule @ sysbus 0x7FFF2000
    uart: uart4
    connPort: gpioPortC
    connPin: 14

uart5: UART.STM32_UART @ sysbus <0x40005000, +0x100>
    -> nvic@53

// SPI. GD32 SPI1 @0x40003800 (STM32 "SPI2") = the W25Q128 FAT disk, CS = PE4.
spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.F4
    IRQ -> nvic@35

// GD32 SPI1 = the W25Q128 disk: GD32_SPI (no DMA) for its byte time (12.5
// MHz at opendm40's /4: ~0.2 ms of polled CPU per 256-byte page, part of the
// fast logger's disk rate; Renode's STM32SPI exchanged bytes instantly).
// No IRQ: neither firmware uses one (STM32SPI's line was never enabled).
spi2: SPI.GD32_SPI @ sysbus 0x40003800

// GD32 SPI2 = the HY3131 bus (opendm40): GD32_SPI with DMA requests on DMA0
// (dma1 here) stream 0 (RX) / stream 7 (TX), the AD2 stream's DMA frames.
spi3: SPI.GD32_SPI @ sysbus 0x40003C00
    dma: dma1
    rxStream: 0
    txStream: 7

spiflash: SPI.W25Q128 @ spi2
    csPort: gpioPortE
    csPin: 4

// I2C. GD32 I2C2 @0x40005C00 (STM32 "I2C3") = Hynitron touch controller (PA8/PC9).
i2c1: I2C.STM32F1_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

i2c2: I2C.STM32F1_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@33
    ErrorInterrupt -> nvic@34

i2c3: I2C.GD32_I2C @ sysbus 0x40005C00
    dmaRxCountAddress: 0x40026044
    EventInterrupt -> nvic@72
    ErrorInterrupt -> nvic@73
    RxDMARequest -> dma1@2
    TxDMARequest -> dma1@4

touch: I2C.CST_Touch @ i2c3 0x5A
    IRQ -> gpioPortE@5

// HY3131 DMM ADC on bit-banged SPI (PC10 SCK, PC11 MISO, PC12 MOSI, PD2 CS)
hy3131: Miscellaneous.HY3131 @ sysbus 0x7FFF1000
    portC: gpioPortC
    portD: gpioPortD
    portA: gpioPortA
    portE: gpioPortE

// ... and on the same pins as GD32 SPI2 (spi3 here, PC10/11/12 AF6): opendm40
// hy3131.rs back end HW / HWS. Bytes only; CS PD2 stays with hy3131.
hy3131spi: SPI.HY3131SpiPort @ spi3
    chip: hy3131

// ADC0 (battery PC5 = channel 15, internal temperature channel 16)
adc1: Analog.SimpleADC @ sysbus 0x40012000

// DAC (generator channel 1 PA4, scope trigger level channel 2 PA5): storage.
dac: Memory.MappedMemory @ sysbus 0x40007400
    size: 0x400

rng: Miscellaneous.STM32_RNG @ sysbus 0x50060800
    series: STM32Series.F4
    -> nvic@80

memtool: Miscellaneous.MemTool @ sysbus 0x7FFF0000

// CPU cost model (peripherals/CpuCost.cs): IsrFactor 1.0 = off.
cpucost: Miscellaneous.CpuCost @ sysbus 0x7FFF4000

// Data reads of the slow flash bank while the stream ISR owns the bus
// (peripherals/FlashWatch.cs, emu/regionc.py): off until Arm.
flashwatch: Miscellaneous.FlashWatch @ sysbus 0x7FFF5000

// Code executed while the stream ISR owns the bus (peripherals/BTrace.cs,
// firmware/tools/region-profile/rprof.py --trace): off until Arm (emu/run.py
// arms it when DM40_BTRACE is set).
btrace: Miscellaneous.BTrace @ sysbus 0x7FFF6000

// 3PA1030 scope ADC + comparator: feeds DMA2 stream 4 at the TIM1 rate, drives PA15.
scopefeed: Miscellaneous.ScopeFeeder @ sysbus 0x7FFF3000
    dma: dma2
    portA: gpioPortA
    sampleTimer: timer1

// USB OTG FS device mode (Synopsys DWC2): DWC2_OTG.cs, exported to a USB/IP
// server with `emulation CreateUSBIPServer` + `host.usb Register sysbus.usbfs`.
usbfs: USB.DWC2_OTG @ sysbus 0x50000000
    IRQ -> nvic@67
